{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajuste-de-protecao.schema.json",
  "type": "object",
  "required": [
    "versao_schema",
    "usuario_da_pessoa",
    "pastas_de_trabalho",
    "escritos_pelas_pecas",
    "comando_do_programa",
    "regra_da_permissao",
    "arquivo_da_regra",
    "conferencia_da_regra",
    "textos"
  ],
  "additionalProperties": false,
  "properties": {
    "versao_schema": { "const": 2 },
    "usuario_da_pessoa": { "$ref": "comum.schema.json#/$defs/linha" },
    "pastas_de_trabalho": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "comum.schema.json#/$defs/linha" }
    },
    "escritos_pelas_pecas": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "comum.schema.json#/$defs/linha" }
    },
    "comando_do_programa": { "$ref": "#/$defs/palavras" },
    "regra_da_permissao": { "$ref": "comum.schema.json#/$defs/texto" },
    "arquivo_da_regra": { "$ref": "comum.schema.json#/$defs/linha" },
    "conferencia_da_regra": { "$ref": "#/$defs/palavras" },
    "textos": {
      "type": "object",
      "required": [
        "sistema_nao_atendido",
        "falta_ferramenta",
        "sem_administrador",
        "ia_com_nome_repetido",
        "programa_com_nome_da_pessoa",
        "vira_administrador",
        "item_em_pasta_de_trabalho",
        "pasta_acima_aberta",
        "atalho_para_fora",
        "item_de_outro_dono_aberto",
        "escrito_de_outro_dono",
        "item_dentro_de_escrito",
        "onde_vai_aparecer_com_outros",
        "pasta_de_trabalho_em_item",
        "pasta_de_trabalho_com_outro_dono",
        "pasta_da_regra_aberta",
        "arquivo_da_regra_sem_a_regra",
        "regra_recusada",
        "permissao_errada",
        "fez",
        "faria",
        "encontrou"
      ],
      "additionalProperties": false,
      "properties": {
        "sistema_nao_atendido": { "$ref": "comum.schema.json#/$defs/texto" },
        "falta_ferramenta": { "$ref": "comum.schema.json#/$defs/texto" },
        "sem_administrador": { "$ref": "comum.schema.json#/$defs/texto" },
        "ia_com_nome_repetido": { "$ref": "comum.schema.json#/$defs/texto" },
        "programa_com_nome_da_pessoa": { "$ref": "comum.schema.json#/$defs/texto" },
        "vira_administrador": { "$ref": "comum.schema.json#/$defs/texto" },
        "item_em_pasta_de_trabalho": { "$ref": "comum.schema.json#/$defs/texto" },
        "pasta_acima_aberta": { "$ref": "comum.schema.json#/$defs/texto" },
        "atalho_para_fora": { "$ref": "comum.schema.json#/$defs/texto" },
        "item_de_outro_dono_aberto": { "$ref": "comum.schema.json#/$defs/texto" },
        "escrito_de_outro_dono": { "$ref": "comum.schema.json#/$defs/texto" },
        "item_dentro_de_escrito": { "$ref": "comum.schema.json#/$defs/texto" },
        "onde_vai_aparecer_com_outros": { "$ref": "comum.schema.json#/$defs/texto" },
        "pasta_de_trabalho_em_item": { "$ref": "comum.schema.json#/$defs/texto" },
        "pasta_de_trabalho_com_outro_dono": { "$ref": "comum.schema.json#/$defs/texto" },
        "pasta_da_regra_aberta": { "$ref": "comum.schema.json#/$defs/texto" },
        "arquivo_da_regra_sem_a_regra": { "$ref": "comum.schema.json#/$defs/texto" },
        "regra_recusada": { "$ref": "comum.schema.json#/$defs/texto" },
        "permissao_errada": { "$ref": "comum.schema.json#/$defs/texto" },
        "fez": { "$ref": "comum.schema.json#/$defs/texto" },
        "faria": { "$ref": "comum.schema.json#/$defs/texto" },
        "encontrou": { "$ref": "comum.schema.json#/$defs/texto" }
      }
    }
  },
  "$defs": {
    "palavras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "comum.schema.json#/$defs/linha" }
    }
  }
}
